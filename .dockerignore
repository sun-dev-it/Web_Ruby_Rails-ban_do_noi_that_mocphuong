
# Ignore git directory
/.git/
/.gitignore

# Ignore bundler config
/.bundle

# Ignore environment files
/.env*

# Ignore secret keys
/config/master.key
/config/credentials/*.key

# Ignore logs and temporary files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore PID files
/tmp/pids/*
!/tmp/pids/.keep

# Ignore local storage files
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets not needed in the build context
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
!/app/assets/builds/tailwind.css
/public/assets

# Ignore CI files
/.github

# Ignore Kamal deployment files
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer
