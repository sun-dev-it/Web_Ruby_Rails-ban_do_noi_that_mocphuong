
# Bundler
/.bundle

# Environment variables and secrets
/.env*
/config/master.key

# Logs and temporary files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep

# Local storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Compiled assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
