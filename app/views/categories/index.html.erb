<div class="py-1 sm:py-3 px-4 sm:px-5 sm:mt-4 mt-2">
  <div class="flex items-center text-xs text-gray-500">
    <%= link_to root_path do %>
      <div class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 mt-[2px]">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <div>Trang chủ</div>
      </div>
    <% end %>
    <span class="mx-2">›</span> 
    <%= link_to "Sản phẩm", products_path %>
    <span class="mx-2">›</span>
    Tất cả sản phẩm
  </div>
</div>  

<div class="text-center mt-4 sm:mt-10 mb-10">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tiện nghi cho không gian sống</p>
  <h2 class="text-3xl md:text-4xl font-extrabold tracking-wide"
      style="color: <%= Color.first&.header || '#ffffff' %>;">
    <span class="inline-block relative">
      SẢN PHẨM CỦA MỘC PHƯƠNG
      <span class="absolute left-1/2 -bottom-2 w-16 h-[3px] -translate-x-1/2 rounded-full"
            style="background-color: <%= Color.first&.header || '#ffffff' %>;">
      </span>
    </span>
  </h2>
  <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-gray-600 md:text-base">
    Tất cả sản phẩm
  </p>
</div>

<%= render "product" %>

<% if @has_more_products %>
  <div class="mt-10 flex justify-center px-4">
    <%= link_to categories_path(page: @next_page, anchor: "product-list"), class: "group inline-flex items-center gap-2 rounded-full border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-900 hover:text-white" do %>
      <span>Xem thêm sản phẩm</span>
      <span class="transition-transform duration-300 group-hover:translate-y-1">↓</span>
    <% end %>
  </div>
<% end %>
<section class="mx-5 mt-16 rounded-xl bg-gray-50 px-6 py-12 text-center sm:px-10">
  <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Cần tư vấn thêm?</p>
  <h2 class="mt-3 text-2xl font-semibold text-gray-900 md:text-3xl">Cùng tạo nên không gian của bạn</h2>
  <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-600">
    Đội ngũ Mộc Phương sẵn sàng hỗ trợ bạn lựa chọn sản phẩm phù hợp với nhu cầu và phong cách riêng.
  </p>
  <%= link_to new_request_path, class: "mt-6 inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-700" do %>
    <span>Gửi yêu cầu tư vấn</span>
    <span>→</span>
  <% end %>
</section>