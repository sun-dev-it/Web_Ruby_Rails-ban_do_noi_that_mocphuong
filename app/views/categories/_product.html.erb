<% if @products.present? %>
  <div id="product-list" class="flex justify-center">
    <div class="w-[95%] sm:w-[85%] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8 mt-4 px-2 sm:px-4">

      <% @products.each do |product| %>
        <article class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
          <%= link_to product_path(product), class: "block" do %>

          <div class="overflow-hidden transition-all duration-300">

            <!-- IMAGE BLOCK -->
            <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">

              <% if product.images.count >= 2 %>

                <!-- Image 1 -->
                <%= image_tag product.images[0],
                      class: "absolute inset-0 w-full h-full object-cover
                              transition-all duration-700 ease-in-out
                              opacity-100 group-hover:opacity-0
                              group-hover:scale-110" %>

                <!-- Image 2 -->
                <%= image_tag product.images[1],
                      class: "absolute inset-0 w-full h-full object-cover
                              transition-all duration-700 ease-in-out
                              opacity-0 group-hover:opacity-100
                              group-hover:scale-110" %>

              <% else %>
                <% if product.images.attached? %>
                  <%= image_tag product.images.first,
                        class: "h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" %>
                <% else %>
                  <div class="flex h-full items-center justify-center px-3 text-center text-xs text-gray-500">
                    Hình ảnh đang được cập nhật
                  </div>
                <% end %>
              <% end %>

              <!-- Overlay -->
              <div class="absolute inset-0 bg-black/30
                          opacity-0 group-hover:opacity-100
                          transition duration-500"></div>

              <!-- Description -->
              <p class="absolute bottom-0 mb-3 left-0 right-0
                        text-white text-sm p-4
                        translate-y-6 opacity-0
                        group-hover:translate-y-0 group-hover:opacity-100
                        transition-all duration-500 line-clamp-2">
                <%= truncate(product.description, length: 120) %>
              </p>

            </div>
            <!-- END IMAGE BLOCK -->

            <!-- CONTENT -->
            <div class="p-4 sm:p-5">
              <p class="text-xs font-semibold text-gray-500 transition group-hover:text-gray-900">
                <%= product.category.name %>
              </p>

              <h3 class="mt-1 text-base font-semibold text-gray-800 transition group-hover:text-gray-500">
                <%= product.name %>
              </h3>

              <p class="mt-3 text-right text-sm font-bold text-gray-900">
                <%= number_to_currency(product.price,
                      unit: "VND ",
                      format: "%n %u",
                      precision: 0) %>
              </p>

            </div>
            <!-- END CONTENT -->

          </div>
          <% end %>
          <div class="px-4 pb-4 sm:px-5 sm:pb-5">
            <%= button_to "Thêm vào giỏ",
                  add_cart_path(product_id: product.id),
                  method: :post,
                  form: { data: { remote: true } },
                  class: "w-full rounded-md bg-gray-900 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700" %>
          </div>
        </article>
      <% end %>

    </div>
  </div>
<% else %>
  <p class="flex justify-center mt-4">Chưa có sản phẩm nào</p>
<% end %>
