<div class="px-5 py-3 text-xs text-gray-600">
  <%= link_to "Trang chủ", root_path, class: "hover:text-gray-900" %>
  <span class="mx-2">›</span>
  <span>Văn phòng thiết kế</span>
</div>

<div class="relative h-[60vh] min-h-[420px] w-full bg-gray-800 bg-cover bg-center"
  <% if @design_office&.image&.attached? %>style="background-image: url('<%= url_for(@design_office.image) %>')"<% end %>>

  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 h-full flex items-center justify-center text-center px-6">
    <div>
      <p class="mb-4 text-xs tracking-[0.4em] text-gray-200">
        DESIGN OFFICE
      </p>
      <h1 class="text-4xl font-semibold text-white md:text-6xl">
        Văn phòng thiết kế
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-gray-200 md:text-base">
        Biến ý tưởng thành những không gian có chiều sâu, tiện nghi và phù hợp với phong cách riêng của bạn.
      </p>
    </div>
  </div>
</div>

<div class="relative z-20 mx-auto -mt-16 mb-20 w-[90%] max-w-6xl">
  <div class="rounded-xl bg-white p-6 shadow-xl sm:p-10">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-gray-500">Tư duy thiết kế</p>
        <div class="space-y-4 text-base leading-8 text-gray-700">
          <%= simple_format(@design_office&.content.presence || "Thông tin văn phòng thiết kế đang được cập nhật.") %>
        </div>
      </div>

      <div class="border-t border-gray-200 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <h2 class="mb-4 text-xl font-semibold text-gray-900">Bắt đầu ý tưởng của bạn</h2>
        <p class="text-sm leading-6 text-gray-600">
          Gửi nhu cầu để đội ngũ thiết kế cùng bạn định hình một không gian phù hợp và khác biệt.
        </p>
        <%= link_to "Gửi yêu cầu tư vấn", new_request_path, class: "mt-6 inline-block rounded-md bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700" %>
      </div>
    </div>
  </div>

  <div class="mt-14">
    <h2 class="mb-6 text-center text-2xl font-semibold text-gray-900 md:text-3xl">Giá trị chúng tôi theo đuổi</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <% [["Cá nhân hóa", "Mỗi thiết kế phù hợp từng không gian"], ["Tính ứng dụng", "Ưu tiên trải nghiệm sử dụng thực tế"], ["Đồng bộ thiết kế & thi công", "Giảm sai lệch khi triển khai"]].each do |title, description| %>
        <div class="rounded-lg border border-gray-200 bg-white p-6 text-center transition hover:-translate-y-1 hover:shadow-md">
          <h3 class="text-lg font-semibold text-gray-900"><%= title %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-500"><%= description %></p>
        </div>
      <% end %>
    </div>
    </div>
  </div>
</div>
