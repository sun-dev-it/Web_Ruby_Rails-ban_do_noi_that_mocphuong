<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 sm:py-14">
    <div class="mx-auto w-full max-w-5xl rounded-2xl border border-gray-200 bg-white p-4 shadow-lg sm:p-8">
      <div class="mb-8 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Mộc Phương</p>
        <p class="text-2xl font-semibold tracking-wide text-gray-900 sm:text-4xl">Giỏ hàng của bạn</p>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-500">Kiểm tra sản phẩm và số lượng trước khi tiến hành đặt hàng.</p>
      </div>
      
<% if @cart_items.empty? %>
  <div class="flex justify-center items-center min-h-[60vh] px-4">
    <div class="mx-auto w-full max-w-md rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center">

      <div class="flex justify-center mb-5">
        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="size-16 text-gray-400">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 3h1.386a1.5 1.5 0 0 1 1.464 1.175L5.383 6.75m0 0h13.867a1.5 1.5 0 0 1 1.464 1.825l-1.5 6A1.5 1.5 0 0 1 17.758 15.75H7.242a1.5 1.5 0 0 1-1.456-1.175L5.383 6.75ZM9 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm9 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
      </div>

      <h2 class="text-2xl font-semibold text-gray-800 mb-3">
        Giỏ hàng trống
      </h2>

      <p class="text-gray-500 mb-8">
        Bạn chưa thêm sản phẩm nào vào giỏ hàng.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-3">

        <%= link_to "Trang cá nhân",
              user_path(current_user),
              class: "rounded-lg border border-gray-300 px-5 py-3 text-center transition hover:bg-white" %>

        <%= link_to "Tiếp tục mua sắm",
              categories_path,
              class: "rounded-lg bg-gray-900 px-5 py-3 text-center text-white transition hover:bg-gray-700" %>

      </div>

    </div>
  </div>
<% else %>


<div class="overflow-x-auto rounded-xl border border-gray-200">
<table class="w-full min-w-[700px] overflow-hidden text-center">
  <thead class="border-b border-gray-200 bg-gray-50">
    <tr>
      <th class="px-4 py-2 border-r border-gray-300">Sản phẩm</th>
      <th class="px-4 py-2 border-r border-gray-300">Giá</th>
      <th class="px-4 py-2 border-r border-gray-300">Số lượng</th>
      <th class="px-4 py-2 border-r border-gray-300">Thành tiền</th>
      <th class="px-4 py-2">Thao tác</th>
    </tr>
  </thead>

  <tbody>
    <% total = 0 %>
    <% @cart_items.each do |item| %>
      <% total += item.quantity * item.product.price %>
      <tr class="border-b border-gray-100 transition hover:bg-gray-50">
        <td class="flex flex-col items-center justify-center px-4 py-2 border-r border-gray-200">
          <% if item.product.images.attached? %>
            <%= image_tag item.product.images.first, class: "mb-2 h-16 w-16 rounded-lg object-cover" %>
          <% end %>
          <span class="font-medium text-gray-700"><%= item.product.name %></span>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= number_to_currency(item.product.price, unit: "VND ", format: "%n %u", precision: 0) %>
          </td>
        <td class="px-4 py-2 flex justify-center border-r border-gray-200 align-middle">
          <%= button_to "−", remove_cart_path(product_id: item.product.id), method: :post, class: "h-8 w-8 rounded-md border border-gray-300 text-gray-700 transition hover:bg-gray-100" %>
          <span class="min-w-6 font-semibold text-gray-800"><%= item.quantity %></span>
          <%= button_to "+", add_cart_path(product_id: item.product.id), method: :post, class: "h-8 w-8 rounded-md border border-gray-300 text-gray-700 transition hover:bg-gray-100" %>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= number_to_currency(item.quantity * item.product.price, unit: "VND ", format: "%n %u", precision: 0) %>
        </td>
        <td class="flex justify-center space-x-2 px-4 py-2">
          <%= button_to "Xóa", remove_all_cart_path(product_id: item.product.id), method: :post, class: "rounded-md px-3 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50" %>
        </td>
      </tr>
    <% end %>

    <tr class="bg-gray-50 font-semibold text-gray-900">
      <td colspan="3" class="border-r border-gray-200 px-4 py-4 text-right">Tổng tiền</td>
      <td colspan="2" class="px-4 py-4"><%= number_to_currency(total, unit: "VND ", format: "%n %u", precision: 0) %></td>
    </tr>
  </tbody>
</table>
</div>



  <div class="mt-6 flex justify-end">
    <%= link_to "Tiến hành đặt hàng", new_order_path, class: "rounded-lg bg-gray-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-700" %>
  </div>
<% end %>

    </div>
</div>