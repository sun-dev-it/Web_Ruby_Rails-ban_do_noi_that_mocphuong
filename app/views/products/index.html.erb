<div class="py-1 sm:py-3 px-4 sm:px-5 sm:mt-4 mt-2">
  <div class="flex items-center text-xs text-gray-500">
    <%= link_to root_path do %>
      <div class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 mt-[2px]">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <div>Trang chủ </div>
      </div>
    <% end %>
    <span class="mx-2">›</span> 
    <%= link_to "Sản phẩm", request.referer %>
    <span class="mx-2">›</span>
    <% if params[:q].present? %>
      <span class="mx-2">›</span>
      <span>Tìm kiếm</span>
    <% end %>
  </div>
</div>

<div class="text-center mt-4 sm:mt-10 mb-10">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tiện nghi cho không gian sống</p>
  <h2 class="text-3xl md:text-4xl font-extrabold tracking-wide"
      style="color: <%= Color.first&.header || '#ffffff' %>;">
    <span class="inline-block relative">
      SẢN PHẨM CỦA MÔC PHƯƠNG
      <span class="absolute left-1/2 -bottom-2 w-16 h-[3px] -translate-x-1/2 rounded-full"
            style="background-color: <%= Color.first&.header || '#ffffff' %>;">
      </span>
    </span>
  </h2>
  <% if params[:q].present? %>
    <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-gray-600 md:text-base">
      Kết quả tìm kiếm cho
      “<%= params[:q] %>”
      <span class="text-gray-500">(<%= @products_search.count %> sản phẩm)</span>
    </p>
  <% end %>
</div>

<%= render "products_search", products_search: @products_search %>

<div class="mt-14 mb-10 text-center">
  <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tuyển chọn Mộc Phương</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-wide text-gray-900 md:text-4xl">Các sản phẩm khác</h2>

  <%= render "categories/product" %>
</div>

<div class="my-12 flex justify-center px-4 sm:my-16">
  <%= link_to categories_path,
        class: "group inline-flex items-center gap-3
                px-8 py-3
                border border-gray-300 rounded-full
                text-gray-800 font-medium
                transition-all duration-300
                hover:bg-black hover:text-white" do %>

    <span>Xem thêm sản phẩm</span>

    <!-- Arrow -->
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         class="w-5 h-5
                transition-transform duration-300
                group-hover:translate-x-2">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M5 12h14M13 5l7 7-7 7" />
    </svg>

  <% end %>
</div>
