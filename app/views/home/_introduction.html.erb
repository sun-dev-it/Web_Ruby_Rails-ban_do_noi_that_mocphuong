<section class="bg-gray-50 px-5 py-16 sm:px-8 lg:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Về Mộc Phương</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-wide text-gray-900 md:text-4xl">Kiến tạo không gian có chiều sâu</h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-gray-600">
        Từ ý tưởng đầu tiên đến công trình hoàn thiện, chúng tôi theo đuổi sự chỉn chu trong từng chi tiết.
      </p>
    </div>

    <div class="grid items-center gap-8 lg:gap-12 <%= @introduction&.youtube_embed_url.present? ? 'lg:grid-cols-2' : 'mx-auto max-w-3xl' %>">
      <div class="rounded-xl bg-white p-6 shadow-sm sm:p-10">
        <div class="text-base leading-8 text-gray-700 md:text-lg">
          <%= simple_format(@introduction&.content.to_s.presence || "Nội dung đang cập nhật.") %>
        </div>
      </div>

      <% if @introduction&.youtube_embed_url.present? %>
        <div class="overflow-hidden rounded-xl bg-white shadow-lg">
          <iframe
            src="<%= @introduction.youtube_embed_url %>"
            title="Video giới thiệu Nội thất Mộc Phương"
            loading="lazy"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="aspect-video w-full <%= @introduction.youtube_aspect_class.to_s %>">
          </iframe>
        </div>
      <% end %>
    </div>
  </div>
</section>