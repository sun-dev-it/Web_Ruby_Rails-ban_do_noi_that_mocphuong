<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 sm:py-14">
    <div class="mx-auto w-full max-w-5xl rounded-2xl border border-gray-200 bg-white p-4 shadow-lg sm:p-8">
      <div class="mb-8 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Mộc Phương</p>
        <p class="text-2xl font-semibold tracking-wide text-gray-900 sm:text-4xl">Chi tiết đơn hàng</p>
        <p class="mt-3 text-sm text-gray-500">Cảm ơn bạn đã tin tưởng lựa chọn sản phẩm của chúng tôi.</p>
      </div>
      
      <div class="mb-8 grid gap-4 rounded-xl bg-gray-50 p-5 text-sm sm:grid-cols-3">
        <p class="text-gray-600"><strong class="text-gray-900">Trạng thái:</strong> <span class="ml-1 inline-flex rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white"><%= @order.status.capitalize %></span></p>
        <p class="text-gray-600"><strong class="text-gray-900">Số điện thoại của bạn:</strong> <%= @order.phone.presence || "Chưa cập nhật" %></p>
        <p class="text-gray-600 sm:text-right"><strong class="text-gray-900">Ngày đặt:</strong> <%= @order.created_at.strftime("%d/%m/%Y %H:%M") %></p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-gray-200">
      <table class="w-full min-w-[650px] overflow-hidden text-center">
        <thead class="border-b border-gray-200 bg-gray-50">
          <tr>
            <th class="px-4 py-2 border-r border-gray-300">Sản phẩm</th>
            <th class="px-4 py-2 border-r border-gray-300">Số lượng</th>
            <th class="px-4 py-2 border-r border-gray-300">Giá</th>
            <th class="px-4 py-2 border-r border-gray-300">Thành tiền</th>
          </tr>
        </thead>
        <tbody>
          <% total = 0 %>
          <% @order.order_items.each do |item| %>
            <% total += item.price * item.quantity %>
            <tr class="border-b border-gray-100 transition hover:bg-gray-50">
          
          
              <td class="border-r border-gray-200 px-4 py-3 align-middle">
                <div class="flex items-center justify-center gap-3">
                  <% if item.product.images.attached? %>
                    <%= image_tag item.product.images.first, class: "h-12 w-12 rounded-lg object-cover" %>
                  <% end %>
                  <span class="font-medium text-gray-800"><%= item.product.name %></span>
                </div>
              </td>
              <td class="border-r border-gray-200 px-4 py-3 align-middle">
                <%= item.quantity %>
              </td>
              <td class="border-r border-gray-200 px-4 py-3 align-middle">
                <%= number_to_currency(item.price, unit: "VND ", format: "%n %u", precision: 0) %>
              </td>
          
              <td class="border-r border-gray-200 px-4 py-3 align-middle">
                <%= number_to_currency(item.price * item.quantity, unit: "VND ", format: "%n %u", precision: 0) %>
              </td>
          
            </tr>
          <% end %>
          <tr class="bg-gray-50 font-semibold text-gray-900">
            <td colspan="3" class="border-r border-gray-200 px-4 py-4 text-right">Tổng tiền</td>
            <td class="px-4 py-4"><%= number_to_currency(total, unit: "VND ", format: "%n %u", precision: 0) %></td>
          </tr>
        </tbody>
      </table>
      </div>
      <div class="mt-6 flex justify-end">
        <%= link_to "Quay lại đơn hàng", user_path(current_user), class: "rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50" %>
      </div>

    </div>
</div>
