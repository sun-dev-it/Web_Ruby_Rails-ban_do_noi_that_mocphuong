<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 sm:py-14">
    <div class="mx-auto w-full max-w-5xl rounded-2xl border border-gray-200 bg-white p-4 shadow-lg sm:p-8">
      <div class="mb-8 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tài khoản Mộc Phương</p>
        <p class="text-2xl font-semibold tracking-wide text-gray-900 sm:text-4xl">Danh sách đơn hàng</p>
        <p class="mt-3 text-sm text-gray-500">Theo dõi trạng thái và lịch sử mua hàng của bạn.</p>
      </div>
      
<% if @orders.empty? %>
  <div class="flex justify-center items-center min-h-[60vh] px-4">
    <div class="mx-auto w-full max-w-md rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center sm:p-10">

      <div class="flex justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="size-16 text-gray-400">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.375 3h17.25M4.5 7.5h15m-13.5 4.5h12m-10.5 4.5h9" />
        </svg>
      </div>

      <h2 class="text-2xl font-semibold text-gray-800 mb-2">
        Chưa có đơn hàng
      </h2>

      <p class="text-gray-500 mb-8">
        Bạn chưa có đơn hàng nào. Hãy khám phá các sản phẩm và đặt hàng ngay!
      </p>

      <div class="flex justify-center gap-3">
        <%= link_to "Trang cá nhân",
              user_path(current_user),
              class: "px-5 py-2 rounded-lg border border-gray-300 hover:bg-gray-100 transition" %>

        <%= link_to "Mua sắm ngay",
              categories_path,
              class: "px-5 py-2 rounded-lg text-white transition",
              style: "background-color: #{Color.first&.header || '#FF5733'};" %>
      </div>

    </div>
  </div>
<% else %>




<div class="overflow-x-auto rounded-xl border border-gray-200">
<table class="w-full min-w-[650px] overflow-hidden text-center">
  <thead class="border-b border-gray-200 bg-gray-50">
    <tr>
      <th class="px-4 py-2 border-r border-gray-300">Trạng thái</th>
      <th class="px-4 py-2 border-r border-gray-300">Tổng tiền</th>
      <th class="px-4 py-2 border-r border-gray-300">Ngày đặt</th>
      <th class="px-4 py-2 border-r border-gray-300">Thao tác</th>
    </tr>
  </thead>

  <tbody>
    <% total = 0 %>
    <% @orders.each do |order| %>
      <% total = order.order_items.sum { |item| item.price * item.quantity } %>
      <tr class="border-b border-gray-100 transition hover:bg-gray-50">
        <td class="flex flex-col items-center justify-center px-4 py-2 border-r border-gray-200">
          <span class="inline-flex rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white"><%= order.status %></span>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= number_to_currency(total, unit: "VND ", format: "%n %u", precision: 0) %>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= order.created_at.strftime("%d/%m/%Y %H:%M") %>
        </td>

        <td>
          <%= link_to "Xem chi tiết", order_path(order), class: "font-semibold text-gray-700 underline underline-offset-4 transition hover:text-gray-500" %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>
</div>



<% end %>



    </div>
</div>