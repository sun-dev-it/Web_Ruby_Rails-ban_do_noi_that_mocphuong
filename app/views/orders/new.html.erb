<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 sm:py-14">
    <div class="mx-auto w-full max-w-5xl rounded-2xl border border-gray-200 bg-white p-4 shadow-lg sm:p-8">
      <div class="mb-8 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Hoàn tất lựa chọn</p>
        <p class="text-2xl font-semibold tracking-wide text-gray-900 sm:text-4xl">Xác nhận đơn hàng</p>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-500">Kiểm tra lại sản phẩm và để lại số điện thoại để chúng tôi liên hệ xác nhận.</p>
      </div>
      
<% if @cart_items.empty? %>
  <div class="rounded-xl border border-gray-200 bg-gray-50 p-8 text-center">
    <p class="text-lg font-semibold text-gray-800">Giỏ hàng trống</p>
    <%= link_to "Quay lại mua sắm", categories_path, class: "mt-5 inline-flex rounded-lg bg-gray-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-gray-700" %>
  </div>
<% else %>




<div class="overflow-x-auto rounded-xl border border-gray-200">
<table class="w-full min-w-[700px] overflow-hidden text-center">
  <thead class="border-b border-gray-200 bg-gray-50">
    <tr>
      <th class="px-4 py-2 border-r border-gray-300">Sản phẩm</th>
      <th class="px-4 py-2 border-r border-gray-300">Giá</th>
      <th class="px-4 py-2 border-r border-gray-300">Số lượng</th>
      <th class="px-4 py-2 border-r border-gray-300">Thành tiền</th>
      <th class="px-4 py-2">Thao tác</th>
    </tr>
  </thead>

  <tbody>
    <% total = 0 %>
    <% @cart_items.each do |item| %>
      <% total += item.quantity * item.product.price %>
      <tr class="border-b border-gray-100 transition hover:bg-gray-50">
        <td class="flex flex-col items-center justify-center px-4 py-2 border-r border-gray-200">
          <% if item.product.images.attached? %>
            <%= image_tag item.product.images.first, class: "mb-2 h-16 w-16 rounded-lg object-cover" %>
          <% end %>
          <span class="font-medium text-gray-700"><%= item.product.name %></span>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= number_to_currency(item.product.price, unit: "VND ", format: "%n %u", precision: 0) %>
          </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= item.quantity %>
        </td>
        <td class="px-4 py-2 border-r border-gray-200 align-middle">
          <%= number_to_currency(item.quantity * item.product.price, unit: "VND ", format: "%n %u", precision: 0) %>
        </td>
        <td class="flex justify-center space-x-2 px-4 py-2">
          <%= button_to "Xóa", remove_all_cart_path(product_id: item.product.id), method: :post, class: "rounded-md px-3 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50" %>
        </td>
      </tr>
    <% end %>

    <tr class="bg-gray-50 font-semibold text-gray-900">
      <td colspan="3" class="border-r border-gray-200 px-4 py-4 text-right">Tổng tiền</td>
      <td colspan="2" class="px-4 py-4"><%= number_to_currency(total, unit: "VND ", format: "%n %u", precision: 0) %></td>
    </tr>
  </tbody>
</table>
</div>



  <div class="mt-8 ml-auto w-full max-w-md rounded-xl border border-gray-200 bg-gray-50 p-5">
    
    <%= form_with url: orders_path, method: :post do %>
      <div class="mb-5">
        <%= label_tag :phone, "Số điện thoại", class: "mb-2 block text-sm font-semibold text-gray-800" %>
        <%= text_field_tag :phone, nil, 
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-sm transition focus:border-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-200",
              placeholder: "Nhập số điện thoại",
              autocomplete: "tel",
              required: true %> <!-- thêm required -->
      </div>
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Quay lại giỏ hàng", cart_path, class: "rounded-lg border border-gray-300 px-4 py-3 text-center text-sm font-medium text-gray-700 transition hover:bg-white" %>
        <%= submit_tag "Xác nhận đặt hàng", class: "rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gray-700" %>
      </div>
    <% end %>
      
  </div>
<% end %>



    </div>
</div>