<div class="py-3 px-5 mt-4">
  <div class="flex text-xs">
      <%= link_to root_path do %>
          <div class="flex hover:text-black">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 mt-[2px]">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
              <div>Trang chủ </div>
          </div>
      <% end %>
      
      > <%= link_to "Thiết bị và phụ kiện", accessories_path %>
  </div>
</div>

<div class="flex justify-center pb-10">
  <div class="w-[90%] sm:w-[80%] z-[47]">
    <div class="text-center mt-10 mb-10">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tiện nghi cho không gian sống</p>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-wide"
          style="color: <%= Color.first&.header || '#ffffff' %>;">
        <span class="inline-block relative">

          THIẾT BỊ VÀ PHỤ KIỆN

          <span class="absolute left-1/2 -bottom-2 w-16 h-[3px] -translate-x-1/2 rounded-full"
                style="background-color: <%= Color.first&.header || '#ffffff' %>;">
          </span>

        </span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-gray-600 md:text-base">
        Những thiết bị và phụ kiện được chọn lọc để hoàn thiện không gian tiện nghi, hiện đại và đồng điệu.
      </p>
    </div>


    <!-- Danh sách project -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">

      <% @accessories.each do |accessory| %>
        <%= link_to accessory_path(accessory.id) do %>

          <div class="group my-2">
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-gray-100 shadow-md transition duration-300 group-hover:-translate-y-1 group-hover:shadow-xl">

              <% if accessory.images.attached? %>
                <%= image_tag accessory.images.first,
                    class: "h-full w-full object-cover transition duration-500 group-hover:scale-110" %>
              <% else %>
                <div class="flex h-full items-center justify-center px-4 text-center text-sm text-gray-500">
                  Hình ảnh đang được cập nhật
                </div>
              <% end %>

              <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/75 via-black/35 to-transparent p-5 opacity-0 transition duration-500 group-hover:opacity-100">
                <div class="text-lg font-medium text-white translate-y-5 transition duration-500 group-hover:translate-y-0">
                  <%= simple_format(truncate(accessory.content, length: 120)) %>
                </div>
              </div>

            </div>

            <div class="mt-4 text-center text-xl font-semibold text-gray-900 transition-colors group-hover:text-gray-600">
              <%= accessory.name %>
            </div>
          </div>

        <% end %>
      <% end %>

    </div>

  </div>
</div>

