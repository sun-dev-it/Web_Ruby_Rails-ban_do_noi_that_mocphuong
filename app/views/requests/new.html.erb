<div class="py-1 sm:py-3 px-4 sm:px-5 sm:mt-4 mt-2">
  <div class="flex items-center text-xs text-gray-500">
    <%= link_to root_path do %>
      <div class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 mt-[2px]">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <div>Trang chủ </div>
      </div>
    <% end %>
    <span class="mx-2">›</span> 
    <span>Gửi yêu cầu tư vấn</span>
</div>

<div class="text-center mt-4 sm:mt-10 mb-10">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Chia sẻ nhu cầu của bạn, đội ngũ Mộc Phương sẽ liên hệ để tư vấn sản phẩm và giải pháp phù hợp.</p>
  <h2 class="text-3xl md:text-4xl font-extrabold tracking-wide"
      style="color: <%= Color.first&.header || '#ffffff' %>;">
    <span class="inline-block relative">
      Gửi yêu cầu tư vấn
      <span class="absolute left-1/2 -bottom-2 w-16 h-[3px] -translate-x-1/2 rounded-full"
            style="background-color: <%= Color.first&.header || '#ffffff' %>;">
      </span>
    </span>
  </h2>
</div>

<div class="mx-auto w-[90%] max-w-6xl pb-16 pt-10">
  <div class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
    <div class="rounded-xl bg-white p-6 shadow-lg sm:p-10">
      <% if @request.errors.any? %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <p class="font-semibold">Vui lòng kiểm tra lại thông tin.</p>
          <ul class="mt-2 list-disc pl-5">
            <% @request.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @request, url: requests_path, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :name, "Họ và tên", class: "mb-2 block text-sm font-semibold text-gray-800" %>
          <%= form.text_field :name, required: true, autocomplete: "name", placeholder: "Nhập họ và tên", class: "w-full rounded-md border border-gray-300 px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200" %>
        </div>

        <div>
          <%= form.label :phone, "Số điện thoại", class: "mb-2 block text-sm font-semibold text-gray-800" %>
          <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "Nhập số điện thoại", class: "w-full rounded-md border border-gray-300 px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200" %>
        </div>

        <div>
          <%= form.label :content, "Nội dung yêu cầu", class: "mb-2 block text-sm font-semibold text-gray-800" %>
          <%= form.text_area :content, required: true, rows: 6, placeholder: "Bạn đang cần tư vấn về sản phẩm hoặc không gian nào?", class: "w-full resize-y rounded-md border border-gray-300 px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200" %>
        </div>

        <%= form.submit "Gửi yêu cầu", class: "w-full rounded-md bg-gray-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-gray-700 sm:w-auto" %>
      <% end %>
    </div>

    <aside class="rounded-xl bg-gray-900 p-6 text-white sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gray-400">Liên hệ trực tiếp</p>
      <h2 class="mt-4 text-2xl font-semibold">Cần trao đổi nhanh?</h2>
      <p class="mt-4 text-sm leading-7 text-gray-300">
        Đội ngũ của chúng tôi sẵn sàng lắng nghe và hỗ trợ bạn trong quá trình lựa chọn.
      </p>

      <div class="mt-8 space-y-4 border-t border-gray-700 pt-6 text-sm text-gray-300">
        <% if @contact&.phone.present? %>
          <p><span class="block text-xs uppercase tracking-wider text-gray-500">Điện thoại</span><%= @contact.phone %></p>
        <% end %>
        <% if @contact&.gmail.present? %>
          <p><span class="block text-xs uppercase tracking-wider text-gray-500">Email</span><%= @contact.gmail %></p>
        <% end %>
        <% if @contact&.address.present? %>
          <p><span class="block text-xs uppercase tracking-wider text-gray-500">Địa chỉ</span><%= @contact.address %></p>
        <% end %>
      </div>
    </aside>
  </div>
</div>
