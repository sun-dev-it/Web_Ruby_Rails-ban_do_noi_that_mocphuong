<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 sm:py-14">
  <div class="mx-auto w-full max-w-2xl rounded-2xl border border-gray-200 bg-white p-6 shadow-lg sm:p-10">

    <div class="mb-8 text-center">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.3em] text-gray-500">Tài khoản Mộc Phương</p>
      <h1 class="text-2xl font-semibold tracking-wide text-gray-900 sm:text-4xl">
      Xin chào <%= @user.name %>!
      </h1>
      <p class="mt-3 text-sm text-gray-500"><%= @user.email %></p>
    </div>

    <div class="mb-8 rounded-xl bg-gray-50 p-5 text-sm text-gray-600">
      <p><strong class="text-gray-900">Tên tài khoản:</strong> <%= @user.name %></p>
      <p class="mt-2"><strong class="text-gray-900">Email:</strong> <%= @user.email %></p>
    </div>

    <div class="space-y-4">

      <%= link_to cart_path,
          class: "group flex items-center justify-between rounded-xl border border-gray-200 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-gray-900 hover:bg-gray-50" do %>

        <span class="text-lg font-medium text-gray-800">
          Giỏ hàng của bạn
        </span>

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="2"
             stroke="currentColor"
             class="size-5">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7" />
        </svg>

      <% end %>

      <%= link_to orders_path,
          class: "group flex items-center justify-between rounded-xl border border-gray-200 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-gray-900 hover:bg-gray-50" do %>

        <span class="text-lg font-medium text-gray-800">
          Đơn hàng của bạn
        </span>

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="2"
             stroke="currentColor"
             class="size-5">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7" />
        </svg>

      <% end %>

    </div>

    <div class="mt-10 flex items-center justify-between border-t border-gray-200 pt-6">
      <%= link_to "Chỉnh sửa tài khoản", edit_user_path(@user), class: "text-sm font-semibold text-gray-700 transition hover:text-gray-900" %>
      <%= button_to logout_path,
            method: :delete,
            class: "text-sm font-semibold text-red-600 transition-colors duration-300 hover:text-red-800" do %>
        Đăng xuất
      <% end %>
    </div>

  </div>
</div>